# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."          # server-only, never exposed

# Postgres (Supabase → Settings → Database). Pooled for app, direct for migrations.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# ── Domains ──────────────────────────────────────────────
NEXT_PUBLIC_ROOT_DOMAIN="mazidigroup.com"    # tenant subdomains hang off this
NEXT_PUBLIC_SITE_URL="https://mazidigroup.com"
NEXT_PUBLIC_PORTAL_URL="https://portal.mazidigroup.com"
AUTH_COOKIE_DOMAIN=".mazidigroup.com"        # leave empty for localhost dev

# ── Dev ──────────────────────────────────────────────────
DEMO_MODE="true"   # first portal login gets demo engagements (dev only)

# ── Stripe (Module 1: billing) ───────────────────────────
# Dashboard → Developers → API keys (test mode)
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
# stripe listen --forward-to localhost:3001/api/webhooks/stripe → whsec_...
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# ── Module 2: employee portal ──
NEXT_PUBLIC_TEAM_URL="http://localhost:3002"

# ── Module 3: admin ──
NEXT_PUBLIC_ADMIN_URL="http://localhost:3003"

# ── Module 4: automations + AI ───────────────────────────
OPENAI_API_KEY="sk-REPLACE_ME"        # platform.openai.com → API keys
OPENAI_MODEL="gpt-4o-mini"            # optional override
CRON_SECRET="change-me-long-random"   # n8n / cron drains POST /api/automations/run

# ── Privacy centre release approvals (apps/web) ──────────
# Server-side, BUILD-TIME approval flags read by `pnpm check:privacy` and, for
# the date, by the complaints page. Deliberately NOT NEXT_PUBLIC_ — they must
# never be read from a client component.
#
# They are only consulted when VERCEL_ENV=production. Leave them unset here and
# in every preview environment: a production build must fail until a human has
# set each one in the Vercel *Production* environment of the web project. Do not
# set them in this file, in code, or on anyone else's behalf.
#
#   PRIVACY_EFFECTIVE_DATE=          # Privacy Lead — publication date, "D MMMM YYYY" (e.g. 29 July 2026)
#   PRIVACY_MAILBOX_VERIFIED=        # Privacy Lead — "true" once privacy@mazidigroup.com is proven monitored
#   PRIVACY_VENDOR_REVIEW_APPROVED=  # Privacy Lead + owner — "true" once VENDOR_INVENTORY.md is signed off
#   PRIVACY_WORDING_APPROVED=        # Legal — "true" once PRIVACY_WORDING_DIFF.md wording is approved
